# Copie ce fichier en .env (jamais commité — voir .gitignore) et remplis les chemins.
# .env ne contient QUE des chemins/config, jamais un secret en clair : le vrai secret
# OAuth reste dans le fichier JSON téléchargé depuis Google Cloud Console.

# Fichier client_secret.json téléchargé depuis Google Cloud Console
# (API & Services > Identifiants > ID client OAuth > type "Application de bureau")
YOUTUBE_CLIENT_SECRETS_FILE=./publication/secrets/client_secret.json

# Où stocker le jeton OAuth obtenu après la première autorisation (créé automatiquement)
YOUTUBE_TOKEN_FILE=./publication/secrets/token.json
